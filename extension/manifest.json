{
  "manifest_version": 3,
  "name": "Browzie for Claude Code",
  "short_name": "Browzie",
  "version": "0.1.0",
  "description": "Lets Claude Code use this browser with a visible, human-paced virtual cursor. Bot checks are always handed to you.",
  "key": "",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "scripting",
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "storage",
    "notifications",
    "webNavigation",
    "webRequest",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Browzie: click to pause or resume Claude. During a handoff, click when you are done.",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
